    <!-- Fehler -->
    <string name="push_error_no_distributor">Kein UnifiedPush-Verteiler installiert. Installiere zuerst ntfy.</string>
    <string name="push_error_missing_token">Gib das ntfy-Zugriffstoken ein.</string>
    <string name="push_error_endpoint_timeout">ntfy hat nicht geantwortet. Öffne die ntfy-App, prüfe, ob dein Server der Standardserver ist und du angemeldet bist, und versuche es erneut.</string>
    <string name="push_error_action_required">ntfy benötigt deine Aufmerksamkeit: Öffne die ntfy-App und prüfe, ob UnifiedPush aktiviert ist (Einstellungen → Erweitert).</string>
    <string name="push_error_registration_failed">ntfy hat die Registrierung abgelehnt. Prüfe Server und Benutzer in der ntfy-App.</string>
    <string name="push_error_not_configured">Push-Benachrichtigungen sind nicht eingerichtet.</string>
    <string name="push_error_network">Uptime Kuma ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut.</string>
    <string name="push_error_not_logged_in">Du bist nicht bei Uptime Kuma angemeldet. Melde dich erneut an.</string>
    <string name="push_error_rate_limited">Zu viele Anfragen. Warte eine Minute und versuche es erneut.</string>
    <string name="push_error_server_rejected">Uptime Kuma hat die Anfrage abgelehnt: %1$s</string>
