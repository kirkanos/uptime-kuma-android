    <!-- Einrichtung -->
    <string name="push_setup_title">Push-Benachrichtigungen</string>
    <string name="push_setup_intro">Alarme sofort erhalten, auch wenn die App geschlossen ist. Uptime Kuma schickt sie über deinen eigenen ntfy-Server an die ntfy-App, die sie per UnifiedPush an diese App weitergibt. Ganz ohne Google-Dienste.</string>
    <string name="push_install_title">ntfy installieren</string>
    <string name="push_install_text">Für Push-Benachrichtigungen wird die ntfy-App als UnifiedPush-Verteiler benötigt.</string>
    <string name="push_install_steps">Nach der Installation:\n1. In der ntfy-App deinen ntfy-Server hinzufügen und als Standardserver festlegen.\n2. Mit dem Nur-Lese-Benutzer anmelden (Einstellungen → Benutzer verwalten).\n3. Hierher zurückkehren.</string>
    <string name="push_install_fdroid">F-Droid</string>
    <string name="push_install_play">Google Play</string>
    <string name="push_install_recheck">Erneut prüfen</string>
    <string name="push_distributor_title">Verteiler</string>
    <string name="push_distributor_text">Es sind mehrere UnifiedPush-Apps installiert. Wähle die, die mit deinem ntfy-Server verbunden ist.</string>
    <string name="push_token_title">ntfy-Zugriffstoken</string>
    <string name="push_token_label">Zugriffstoken des sendenden Benutzers</string>
    <string name="push_token_help">Token des ntfy-Benutzers, der an up*-Topics senden darf (siehe Server-README). Der Admin erstellt es auf dem Server mit:</string>
    <string name="push_token_show">Token anzeigen</string>
    <string name="push_token_hide">Token verbergen</string>
    <string name="push_apply_all">Für alle vorhandenen Monitore benachrichtigen</string>
    <string name="push_apply_all_help">Verknüpft dieses Gerät mit allen Monitoren. Für neue Monitore in Uptime Kuma aktivieren.</string>
    <string name="push_setup_button">Einrichten</string>
    <string name="push_setup_working">Registrierung bei ntfy und Uptime Kuma…</string>
    <string name="push_success_title">Push-Benachrichtigungen sind aktiv</string>
    <string name="push_success_text">Uptime Kuma sendet Alarme jetzt an dieses Gerät.</string>
    <string name="push_send_test">Testbenachrichtigung senden</string>
    <string name="push_test_sending">Wird gesendet…</string>
    <string name="push_test_sent">Test gesendet. Er sollte in wenigen Sekunden ankommen.</string>
    <string name="push_done">Fertig</string>
    <string name="push_reconfigure">Neu einrichten</string>
    <string name="push_disable">Push deaktivieren</string>
    <string name="push_battery_title">Zuverlässige Zustellung</string>
    <string name="push_battery_text">Alarme werden von der ntfy-App zugestellt. Lass in ntfy die sofortige Zustellung aktiviert und nimm ntfy von der Akku-Optimierung aus. Manche Hersteller erfordern zusätzliche Schritte.</string>
    <string name="push_battery_link">dontkillmyapp.com öffnen</string>
    <string name="push_permission_title">Benachrichtigungen sind blockiert</string>
    <string name="push_permission_text">Erlaube Benachrichtigungen, damit Alarme angezeigt werden können.</string>
    <string name="push_permission_button">Erlauben</string>

