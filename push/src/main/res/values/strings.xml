    <string name="push_battery_title">Reliable delivery</string>
    <string name="push_battery_text">Alerts are delivered by the ntfy app. In ntfy, keep instant delivery enabled and exempt ntfy from battery optimization. Some manufacturers need extra steps.</string>
    <string name="push_battery_link">Open dontkillmyapp.com</string>
