    <!-- Setup screen -->
    <string name="push_setup_title">Push notifications</string>
    <string name="push_setup_intro">Get alerts instantly, even when the app is closed. Uptime Kuma sends them through your own ntfy server to the ntfy app, which passes them to this app via UnifiedPush. No Google services involved.</string>
    <string name="push_install_title">Install ntfy</string>
    <string name="push_install_text">Push delivery needs the ntfy app as UnifiedPush distributor.</string>
    <string name="push_install_steps">After installing:\n1. In the ntfy app, add your ntfy server and set it as default server.\n2. Log in with the read-only user (Settings → Manage users).\n3. Come back here.</string>
    <string name="push_install_fdroid">F-Droid</string>
    <string name="push_install_play">Google Play</string>
    <string name="push_install_recheck">Check again</string>
    <string name="push_distributor_title">Distributor</string>
    <string name="push_distributor_text">Several UnifiedPush apps are installed. Choose the one connected to your ntfy server.</string>
    <string name="push_token_title">ntfy access token</string>
    <string name="push_token_label">Access token of the publishing user</string>
    <string name="push_token_help">Token of the ntfy user that may publish to up* topics (see the server README). The admin creates it on the server with:</string>
    <string name="push_token_show">Show token</string>
    <string name="push_token_hide">Hide token</string>
    <string name="push_apply_all">Alert for all existing monitors</string>
    <string name="push_apply_all_help">Attaches this device to every monitor and makes it the default for new monitors.</string>
