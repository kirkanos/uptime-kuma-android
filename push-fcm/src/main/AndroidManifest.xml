<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Receives the relay's FCM data messages and token changes (wins over the SDK's own service, priority -500). -->
        <service
            android:name=".KumaFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            No automatic Firebase initialization: there is no google-services.json, the user's own project values
            are stored at runtime and PushInitializer initializes the default FirebaseApp from Application.onCreate.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <!-- No token before the user set up the Firebase transport; enabled at runtime after a successful setup. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Notification messages are not used (data messages only); never let Play services post them. -->
        <meta-data
            android:name="firebase_messaging_notification_delegation_enabled"
            android:value="false" />
        <!-- Default, stated explicitly: no delivery metrics export. -->
        <meta-data
            android:name="delivery_metrics_exported_to_big_query_enabled"
            android:value="false" />
        <!-- No Analytics SDK is included; belt and braces in case a dependency ever pulls it in. -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
    </application>
</manifest>
