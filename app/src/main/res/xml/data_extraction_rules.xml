<?xml version="1.0" encoding="utf-8"?>
<!-- Server credentials live in DataStore / EncryptedSharedPreferences and must not leave the device via backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
